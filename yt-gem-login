#!/usr/bin/env python3
"""
yt-gem-login — One-time sign-in for yt-gem (and gem-pw).

Launches visible Chromium with the shared Gemini profile
(~/.gemini-cli/cr-profile, falling back to pw-profile if that is the one
that already exists). Sign into Gemini once; the profile persists for
every later yt-gem / gem-pw call. No credentials are stored in this repo.

Usage: yt-gem-login
"""

import asyncio
import os
import sys
import time
from pathlib import Path


def _pick_profile():
    home = Path.home() / ".gemini-cli"
    for cand in (home / "cr-profile", home / "pw-profile"):
        if cand.exists():
            return str(cand)
    return str(home / "cr-profile")


async def main():
    from playwright.async_api import async_playwright

    profile = _pick_profile()
    Path(profile).parent.mkdir(parents=True, exist_ok=True)
    print(f"[yt-gem-login] Profile: {profile}")
    async with async_playwright() as p:
        ctx = await p.chromium.launch_persistent_context(
            user_data_dir=profile, headless=False,
            args=["--no-sandbox", "--disable-gpu",
                  "--disable-blink-features=AutomationControlled"],
            ignore_default_args=["--enable-automation"])
        try:
            page = await ctx.new_page()
            await page.goto("https://gemini.google.com",
                            wait_until="domcontentloaded", timeout=30000)
            await asyncio.sleep(3)
            body = await page.inner_text("body")
            if "Sign in" not in body[:600]:
                print("[yt-gem-login] Already signed in!")
            else:
                print("\n=== Sign into Gemini in the Chromium window ===")
                print("Waiting for sign-in... (2 min timeout)")
                for _ in range(60):
                    await asyncio.sleep(2)
                    try:
                        body = await page.inner_text("body")
                        if "Sign in" not in body[:600] and len(body) > 200:
                            print("[yt-gem-login] Sign-in detected!")
                            break
                    except Exception:
                        pass
                else:
                    print("[yt-gem-login] Timeout — did you sign in?")
            print(f"[yt-gem-login] Profile saved to {profile}")
            print("[yt-gem-login] Ready! Use: yt-gem <youtube-url>")
            await asyncio.sleep(2)
        finally:
            await ctx.close()


if __name__ == "__main__":
    asyncio.run(main())
