async def _find_input(page, timeout=15):
    t0 = time.time()
    while time.time() - t0 < timeout:
        el = await _pick(page, [
            'div[role="textbox"][aria-label*="輸入提示"]',
            'div[role="textbox"][aria-label*="prompt" i]',
            'div[role="textbox"][aria-label*="Enter a prompt"]',
            'rich-textarea div[contenteditable="true"]',
            'div[contenteditable="true"]:not(.ql-clipboard)',
        ])
        if el:
            return el
        await asyncio.sleep(1)
    return None


async def _type_and_submit(page, text):
    """Insert prompt and submit. Verifies the text landed before pressing
    Enter — submitting a half-typed prompt is how empty/confused answers
    happen (gem-pw lesson). Returns True on submit, False on failure."""
    el = await _find_input(page)
    if not el:
        return False
    try:
        await page.keyboard.press("Escape")
        await asyncio.sleep(0.4)
    except Exception:
        pass
    try:
        await el.focus(timeout=5000)
    except Exception:
        pass
    await el.click()
    await asyncio.sleep(0.3)
    await page.keyboard.press("Control+a")
    await asyncio.sleep(0.1)
    await page.keyboard.press("Backspace")
    await asyncio.sleep(0.3)
    try:
        for i in range(0, len(text), 4000):
            await page.keyboard.insert_text(text[i:i + 4000])
            await asyncio.sleep(0.15)
    except Exception as e:
        _log(f"insert_text failed ({e}); falling back to el.type")
        for i in range(0, len(text), 200):
            await el.type(text[i:i + 200], delay=2)
    await asyncio.sleep(0.3)
    try:
        composer = await page.evaluate("""() => {
            const el = document.querySelector('div[contenteditable="true"][role="textbox"], rich-textarea div[contenteditable="true"]');
            return el ? (el.innerText || '') : '';
        }""")
        # Quill normalizes paragraphs: a single \n in the prompt becomes
        # \n\n in innerText (measured 2026-10-25: brief prompt 1261 chars
        # landed as 1289, tail 'else:\\n\\nVIDEO_NOT_ACCESSIBLE' vs prompt
        # 'else:\\nVIDEO_NOT_ACCESSIBLE'), so an exact tail match always
        # failed and yt-gem reported TYPE_FAILED on a fully-typed prompt.
        # Normalize consecutive newlines before comparing.
        comp_norm = re.sub(r"\n+", "\n", composer or "").strip()
        text_norm = re.sub(r"\n+", "\n", text.strip())
        landed = text_norm[-80:] in comp_norm[-250:]
    except Exception:
        landed = False
    if not landed:
        _log("WARNING: composer text not confirmed; NOT submitting")
        return False
    await page.keyboard.press("Enter")
    return True


async def _wait_response(page, timeout=300):
    """Poll for the model response. Placeholder-guard + stability check,
    ported from gem-pw: never return 'Analyzing…' as a result, and never
    return a still-streaming half-answer as final."""
    t0 = time.time()
    resp = ""
    placeholders = ("analyzing", "generating", "thinking", "loading", "wait",
                    "正在分析", "產生中", "思考中", "分析中", "載入中")

    def _is_placeholder(t):
        s = (t or "").strip().lower()
        if not s:
            return True
        return any(p in s for p in placeholders) and len(s) < 40

    for i in range(max(1, timeout // 3)):
        await asyncio.sleep(3)
        _log(f"poll {i + 1}/{timeout // 3}")
        try:
            t = await page.evaluate("""() => {
                const msgs = document.querySelectorAll('.response-content, message-content, model-response');
                return msgs.length ? msgs[msgs.length-1].innerText : '';
            }""")
            if t and len(t) > len(resp):
                resp = t
        except Exception:
            pass
        if resp and not _is_placeholder(resp):
            try:
                loading = await page.evaluate("""() => {
                    const sel = '.loading, .generating, .dot-pulse, [aria-busy="true"], .progress-indicator, .response-loading, .stream-text';
                    return document.querySelectorAll(sel).length;
                }""")
                if loading == 0:
                    await asyncio.sleep(2)
                    try:
                        t = await page.evaluate("""() => {
                            const msgs = document.querySelectorAll('.response-content, message-content');
                            return msgs.length ? msgs[msgs.length-1].innerText : '';
                        }""")
                        if t:
                            resp = t
                    except Exception:
                        pass
                    break
            except Exception:
                pass
        if resp and not _is_placeholder(resp) and i >= 5:
            try:
                t = await page.evaluate("""() => {
                    const msgs = document.querySelectorAll('.response-content, message-content');
                    return msgs.length ? msgs[msgs.length-1].innerText : '';
                }""")
                if t == resp:
                    await asyncio.sleep(1)
                    t2 = await page.evaluate("""() => {
                        const msgs = document.querySelectorAll('.response-content, message-content');
                        return msgs.length ? msgs[msgs.length-1].innerText : '';
                    }""")
                    if t2 == resp:
                        _log("stable response, done")
                        break
            except Exception:
                pass
    if _is_placeholder(resp):
        _log("timed out while response still a placeholder; treating as empty")
        resp = ""
    return resp, time.time() - t0


async def _click_menuitem_at(page, cands):
    hit = await page.evaluate("""(cands) => {
        const sel = '[role=menuitem],[role=option],[role=menuitemradio]';
        for (const it of document.querySelectorAll(sel)) {
            const t = (it.innerText || it.getAttribute('aria-label') || '').replace(/\\s+/g, ' ');
            for (const c of cands) {
                if (t.includes(c) && it.offsetParent) {
                    const r = it.getBoundingClientRect();
                    return {x: r.x + r.width/2, y: r.y + r.height/2};
                }
            }
        }
        return null;
    }""", cands)
    if hit:
        await page.mouse.click(hit["x"], hit["y"])
        await asyncio.sleep(1.0)
        return True
    return False


async def _select_model(page, model, thinking=None):
    """Best-effort model + thinking pick (Pro/Flash, Extended thinking).
    The menu closes after each selection, so Extended thinking re-opens
    the picker (gem-pw lesson). A failed pick is a warning, not a failure
    — the default model still distills the video."""
