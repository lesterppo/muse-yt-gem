def _fetch_captions(video_id):
    """Fetch a video's captions (manual first, then auto-generated) via
    yt-dlp into a temp dir. Returns (transcript_text, lang) or (None, None).
    Transcript is capped at ~15,000 chars at a line boundary."""
    if not _ensure_ytdlp():
        return None, None
    dep_dir = _HERMES_HOME / ".hermes" / "yt_gem_deps"
    env = dict(os.environ)
    pp = str(dep_dir)
    env["PYTHONPATH"] = pp + (":" + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    url = canonical_url(video_id)
    try:
        with tempfile.TemporaryDirectory(prefix="yt_gem_cap_") as td:
            for flag in ("--write-subs", "--write-auto-subs"):
                # --no-check-certificates: this VM's egress is TLS-intercepted
                # with a CA that is not in yt-dlp's bundle, so plain yt-dlp
                # fails with CERTIFICATE_VERIFY_FAILED on YouTube's API
                # pages (measured 2026-10-25). This downloads only public
                # captions, no credentials are sent, so disabling cert
                # verification for this one download is the pragmatic fix.
                # Player clients are tried in turn: YouTube's bot-check
                # ("Sign in to confirm you're not a bot") is flaky per
                # client on this VM — the default client failed at 21:24
                # while android succeeded for the Shorts download at 21:02,
                # so one client failing must not end the fetch.
                vtts = []
                for client in (None, "android", "ios"):
                    cmd = [sys.executable, "-m", "yt_dlp",
                           "--no-check-certificates", "--skip-download",
                           flag, "--sub-langs", "zh.*,en.*",
                           "--sub-format", "vtt", "-o", "cap"]
                    if client:
                        cmd += ["--extractor-args",
                                f"youtube:player_client={client}"]
                    cmd.append(url)
                    r = subprocess.run(cmd, cwd=td, env=env, timeout=120,
                                       stdout=subprocess.PIPE,
                                       stderr=subprocess.PIPE, text=True)
                    vtts = sorted(Path(td).glob("cap.*.vtt"))
                    if vtts:
                        break
                    err_tail = (r.stderr or "")[-200:].replace("\n", " ")
                    _log(f"caption fetch ({flag}, client={client or 'default'}) "
                         f"no .vtt (rc={r.returncode}): {err_tail}")
                if not vtts:
                    continue
                # Prefer a manual caption file; auto files from the second
                # pass are only reached when the first pass found nothing.
                for vf in vtts:
                    text = _vtt_to_text(vf.read_text(encoding="utf-8", errors="replace"))
                    if len(text) < 100:
                        continue
                    lang = vf.stem.split(".", 1)[-1] if "." in vf.stem else "?"
                    if len(text) > 15000:
                        cut = text[:15000].rsplit("\n", 1)[0]
                        text = cut + "\n[transcript truncated at ~15,000 chars]"
                    return text, lang
    except Exception as e:
        _log(f"caption fetch failed: {e}")
    return None, None


def _transcript_prompt(video_id, mode, question, transcript):
    """Build a distillation prompt that distills FROM the caption
    transcript instead of from the video URL. The URL-only prompt's
    VIDEO_NOT_ACCESSIBLE sentinel is replaced: with a transcript in hand,
    refusing on 'cannot watch' grounds would be wrong."""
    prompt = build_prompt(video_id, mode=mode, question=question)
    sentinel = ("If you cannot access, play, or hear this video for any reason "
                "(private, removed, age-restricted, region-blocked, no captions and "
                "unclear audio), reply with exactly this and nothing else:\n"
                "VIDEO_NOT_ACCESSIBLE — followed by one short sentence explaining why.")
    prompt = prompt.replace(
        sentinel,
        "You HAVE the video's caption transcript below, so do NOT refuse on "
        "the grounds that you cannot watch the video. Distill from the "
        "transcript. If it is truncated or a section is missing from it, "
        "say so explicitly. (The sentinel token is deliberately not named "
        "here, so it cannot leak into the output by priming.)")
    return (prompt + "\n\n---\nCAPTION TRANSCRIPT (this is your source — "
            "timestamps below are caption cue times):\n\n" + transcript)


async def cmd_distill_webapi(args, video_id, mode, question):
    """WebAPI dispatch for one distillation. Returns the pointer dict,
    or an _err dict (WEBAPI_FAILED / NOT_SIGNED_IN / VIDEO_NOT_ACCESSIBLE
    / EMPTY). The caller (cmd_distill) decides on browser fallback.
    On a URL-only VIDEO_NOT_ACCESSIBLE, retries once with the caption
    transcript (see _fetch_captions); the pointer's "source" field says
    which path produced the result ("url" or "captions:<lang>")."""
    prompt = build_prompt(video_id, mode=mode, question=question)
    if not _acquire_lock():
        return _err("LOCKED", "Another gem-pw/yt-gem run holds the Chromium profile lock; wait and retry.")
    try:
        try:
            resp, elapsed = await _webapi_generate(args, prompt)
        except Exception as e:
            msg = str(e)
            if "NOT_SIGNED_IN" in msg:
                return _err("NOT_SIGNED_IN",
                            "Chromium profile has no Gemini session. Run yt-gem-login once, then retry.")
            return _err("WEBAPI_FAILED", f"WebAPI backend failed: {msg[:200]}")
        resp = resp.strip()
        source = "url"
        if resp.startswith("VIDEO_NOT_ACCESSIBLE"):
            _log("webapi URL-only refused; retrying with caption transcript")
            transcript, lang = _fetch_captions(video_id)
            if not transcript:
                _log("no captions available for transcript retry")
                return _err("VIDEO_NOT_ACCESSIBLE", resp[:300],
                            video_id=video_id, url=canonical_url(video_id))
            try:
                resp2, elapsed2 = await _webapi_generate(
                    args, _transcript_prompt(video_id, mode, question, transcript))
            except Exception:
                resp2 = ""
            if not resp2 or resp2.strip().startswith("VIDEO_NOT_ACCESSIBLE"):
                return _err("VIDEO_NOT_ACCESSIBLE", resp[:300],
                            video_id=video_id, url=canonical_url(video_id))
            resp, elapsed, source = resp2.strip(), elapsed2, f"captions:{lang}"
        result = _save_distill(args, video_id, mode, question, resp, elapsed, backend="webapi")
        if "model" in result:
            result["model"] = "auto"
        result["source"] = source
        return result
    finally:
        _release_lock()


# ── Commands ──────────────────────────────────────────────────────────────
_TRANSIENT = {"EMPTY", "NO_INPUT", "TYPE_FAILED", "TRANSIENT_TIMEOUT"}


async def cmd_distill(args, video_id, mode, question, force_forwarder=False):
    # Backend dispatch: --backend auto (default) tries WebAPI first and
    # falls back to the browser UI on failure; --backend webapi fails
    # instead of falling back; --backend browser skips WebAPI entirely.
    # --gem / --followup are browser-only (see _webapi header note).
    backend = getattr(args, "backend", "auto")
    if backend in ("auto", "webapi") and not args.gem and not args.followup:
        res = await cmd_distill_webapi(args, video_id, mode, question)
        if res.get("ok"):
            return res
        _log(f"webapi backend -> {res.get('err')}: {res.get('msg', '')[:120]}")
        # 2026-10-25 fix: VIDEO_NOT_ACCESSIBLE no longer blocks the browser
        # fallback in auto mode — the browser path genuinely watches the
        # video and succeeded on m19LBe9J1bQ after WebAPI refused it.
        # NOT_SIGNED_IN / LOCKED still return: the browser would hit the
        # same missing session / lock.
        if backend == "webapi" or res.get("err") in ("NOT_SIGNED_IN", "LOCKED"):
            return res
        _log("falling back to browser backend")
    prompt = build_prompt(video_id, mode=mode, question=question)
    if not _acquire_lock():
        return _err("LOCKED", "Another gem-pw/yt-gem run holds the Chromium profile lock; wait and retry.")
    pw = ctx = page = None
    try:
        pw, ctx, page = await _launch(cdp=args.cdp, force_forwarder=force_forwarder)
        # Follow-up: resume the saved conversation instead of a new chat.
        conv_url = None
        if args.followup and args.session:
            sp = Path(args.session)
            if sp.exists():
                try:
                    conv_url = json.loads(sp.read_text()).get("conversation_url")
                except Exception:
                    conv_url = None
        if args.gem:
            target = f"https://gemini.google.com/gem/{args.gem}"
        elif conv_url:
            target = conv_url
        else:
            target = APP_URL
        await page.goto(target, timeout=30000, wait_until="domcontentloaded")
        await asyncio.sleep(3)
        await _dismiss_dialogs(page)
        if not await _is_signed_in(page):
            return _err("NOT_SIGNED_IN",
                        "Chromium is not signed into Gemini. Run yt-gem-login (or gem-pw-login) once, then retry.")
        await _select_model(page, args.model, thinking=args.thinking)
        if not await _type_and_submit(page, prompt):
            # Distinguish "no composer" from "text did not land".
            el = await _find_input(page, timeout=5)
            return _err("NO_INPUT" if not el else "TYPE_FAILED",
                        "Prompt did not land in the Gemini composer; retry.")
        resp, elapsed = await _wait_response(page, timeout=args.timeout)
        if not resp or not resp.strip():
            return _err("EMPTY", "No response extracted within timeout; retry with -t 600 for long videos.")
        resp = resp.strip()
        if resp.startswith("VIDEO_NOT_ACCESSIBLE"):
            return _err("VIDEO_NOT_ACCESSIBLE", resp[:300],
                        video_id=video_id, url=canonical_url(video_id))
        return _save_distill(args, video_id, mode, question, resp, elapsed,
                             backend="browser", session_url=page.url)
    except Exception as e:
        name = type(e).__name__
        msg = str(e)
        # Network failure is NOT transient-retryable: a second launch hits
        # the same tunnel/proxy wall and doubles the cost. Surface it as
        # NETWORK so the caller can move the run to a network that reaches
        # Gemini (e.g. a residential IP / the user's own device) instead
        # of looping. Observed on the reference VM: curl to example.com
        # returns 200 while gemini.google.com returns 000 through the same
        # egress proxy — i.e. Gemini is unreachable from that network,
        # not a yt-gem selector bug.
        if "net::ERR_" in msg or "ERR_TUNNEL" in msg or "ERR_PROXY" in msg:
            first = msg.splitlines()[0] if msg else name
            return _err("NETWORK",
                        f"Chromium could not reach gemini.google.com from this network ({first[:120]}). "
                        "Retry from a network that reaches Gemini (residential IP / your own device), not by relaunching here.",
                        video_id=video_id)
        if name in ("TimeoutError", "Error"):
            return _err("TRANSIENT_TIMEOUT", f"{name}: {msg[:160]}")
        return _err("TRANSIENT_TIMEOUT", f"{name}: {msg[:200]}")
    finally:
        if pw is not None:
            try:
                await _close_session(pw, ctx, page)
            except Exception:
                pass
        _release_lock()


async def _run_with_retry(args, video_id, mode, question):
    res = await cmd_distill(args, video_id, mode, question)
    attempts = 1
    while (isinstance(res, dict) and res.get("ok") is False
           and res.get("err") in _TRANSIENT and attempts < 2):
        _log(f"transient {res.get('err')}; retry {attempts}/1 (video re-analysis is expensive, so only one retry)")
        await asyncio.sleep(2)
        res = await cmd_distill(args, video_id, mode, question)
        attempts += 1
    # NETWORK via a CDP browser is worth exactly one forwarder retry: the
    # CDP browser may have been started without the forwarder proxy, while
    # a headed+forwarder launch reaches Gemini. If the forwarder path was
    # already used (the egress-proxy VM default), a second attempt would
    # hit the same wall, so do not retry then.
    if (isinstance(res, dict) and res.get("err") == "NETWORK"
            and not _needs_forwarder() and os.environ.get("YT_GEM_NO_FWD") != "1"):
        _log("NETWORK via first path; retrying once via localhost forwarder")
        res = await cmd_distill(args, video_id, mode, question, force_forwarder=True)
    return res


# ── CLI ───────────────────────────────────────────────────────────────────
def build_parser():
    p = argparse.ArgumentParser(
        prog="yt-gem",
        description="Distill a YouTube video via free Gemini web — detailed, "
                    "timestamped markdown on disk, JSON pointer on stdout.")
    p.add_argument("url", nargs="?", help="YouTube URL, youtu.be link, or 11-char video id")
    p.add_argument("question", nargs="*", help="Optional question about the video (ask mode)")
    p.add_argument("--mode", choices=["detail", "brief", "chapters", "claims"],
                   help="Distillation mode (default: detail)")
    p.add_argument("--brief", action="store_true", help="Shortcut for --mode brief")
    p.add_argument("--chapters", action="store_true", help="Shortcut for --mode chapters")
    p.add_argument("--claims", action="store_true", help="Shortcut for --mode claims")
    p.add_argument("--followup", action="store_true",
                   help="Ask a follow-up in the saved conversation (-c required)")
    p.add_argument("-c", "--session", help="Session file: resume conversation / save conversation URL")
    p.add_argument("--gem", help="Distill through a specific Gemini Gem id")
    p.add_argument("-m", "--model", default="pro", choices=["pro", "flash"],
                   help="Gemini model in the web UI (default: pro)")
    p.add_argument("--thinking", choices=["standard", "extended"],
                   help="Thinking tier in the web UI model picker (extended = longer, deeper analysis)")
    p.add_argument("-t", "--timeout", type=int, default=300,
                   help="Seconds to wait for Gemini's response (default: 300; long videos may need 600+)")
    p.add_argument("-o", "--out", help="Output markdown path (default: cache path for canonical modes)")
    p.add_argument("--force", action="store_true", help="Ignore cache, re-distill")
    p.add_argument("--no-cache", action="store_true",
                   help="Do not read the cache (result is still saved to the cache path)")
    p.add_argument("--cdp", help="CDP URL override (default: $YT_GEM_CDP / 127.0.0.1:9224)")
    p.add_argument("--backend", choices=["auto", "webapi", "browser"], default="auto",
                   help="Distillation backend (default: auto = WebAPI first, browser fallback; "
                        "webapi = HTTP via gemini-webapi + profile cookies, no fallback; "
                        "browser = Chromium UI as before; --gem/--followup are browser-only)")
    p.add_argument("--dry-run", action="store_true", help="Parse + build prompt only, no browser")
    p.add_argument("--print-prompt", action="store_true", help="Print the exact prompt (with --dry-run, or to stderr otherwise)")
    p.add_argument("-q", "--quiet-json", action="store_true", help="Compact pointer JSON on stdout")
    p.add_argument("--version", action="store_true", help="Print version")
    return p


def resolve_mode(args):
    if args.mode:
        return args.mode
    if args.brief:
        return "brief"
    if args.chapters:
        return "chapters"
    if args.claims:
        return "claims"
    return "detail"


def main(argv=None):
    global QUIET, JSON_OUT
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"yt-gem {__version__}")
        return 0
    QUIET = args.quiet_json
    JSON_OUT = args.quiet_json
    question = " ".join(args.question).strip() if args.question else None
    # Follow-up ergonomics: `yt-gem --followup -c sess.json "question"` puts
    # the question in the first positional slot (there is no URL in this
    # mode), so promote it instead of demanding a second positional.
    if args.followup and not question and args.url:
        question = args.url
        args.url = None

    # Follow-up path: no URL needed, session + question required.
    if args.followup:
        if not args.session or not question:
            _emit(_err("USAGE", "Follow-up needs -c sess.json and a question: yt-gem --followup -c sess.json \"...\""))
            return 2
        sp = Path(args.session)
        video_id = None
        if sp.exists():
            try:
                video_id = json.loads(sp.read_text()).get("video_id")
            except Exception:
                pass
        if not video_id:
            _emit(_err("USAGE", "Session file has no video_id; distill the video first, then follow up."))
            return 2
        res = asyncio.run(_run_with_retry(args, video_id, "ask", question))
        _emit(res)
        return 0 if res.get("ok") else 1

    if not args.url:
        _emit(_err("USAGE", "Provide a YouTube URL or video id. See yt-gem --help."))
        return 2
    video_id = parse_youtube_id(args.url)
    if not video_id:
        _emit(_err("BAD_URL", "Not a YouTube video URL or id (need watch?v=, youtu.be/, shorts/, live/, embed/, or an 11-char id).",
                   url=args.url))
        return 2
    mode = "ask" if question else resolve_mode(args)

    # Dry run: no browser, no lock, no network.
    if args.dry_run:
        prompt = build_prompt(video_id, mode=mode, question=question)
        if args.print_prompt:
            print(prompt)
            return 0
        md_path, sidecar = load_cached(video_id, mode) if not question else (None, None)
        _emit(_ok(dry_run=True, video_id=video_id, url=canonical_url(video_id),
                  mode=mode, prompt_chars=len(prompt), cached=bool(md_path),
                  cache_file=str(md_path) if md_path else None))
        return 0
    if args.print_prompt and not args.dry_run:
        sys.stderr.write(build_prompt(video_id, mode=mode, question=question) + "\n")

    # Cache: canonical modes only, unless --force / --no-cache / explicit -o.
    if not question and not args.force and not args.no_cache and not args.out:
        md_path, sidecar = load_cached(video_id, mode)
        if md_path:
            sc = sidecar or {}
            _emit(_ok(f=str(md_path), s=md_path.stat().st_size,
                      t=0, video_id=video_id, url=canonical_url(video_id),
                      mode=mode, title=sc.get("title", ""),
                      sections=sc.get("sections", []),
                      timestamps=sc.get("timestamps", 0), cached=True))
            return 0

    res = asyncio.run(_run_with_retry(args, video_id, mode, question))
    _emit(res)
    return 0 if res.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
