async def _is_signed_in(page):
    """Fast sign-in check after loading /app: a sign-in wall means the
    profile has no Gemini session — fail fast instead of burning the
    whole timeout waiting for a response that will never come."""
    try:
        body = await page.evaluate("document.body.innerText")
        head = (body or "")[:800]
        if "Sign in" in head and "Ask Gemini" not in body:
            return False
        inp = await page.query_selector('div[role="textbox"]')
        return inp is not None
    except Exception:
        return False


# ── WebAPI / HTTP backend (added 2026-10-25) ─────────────────────────────
# yt-gem originally drove the Gemini web UI in Chromium. The WebAPI path
# talks to the same free Gemini web backend over HTTP via gemini-webapi,
# using the session cookies of the already-signed-in Chromium profile
# (read in-process via Playwright ctx.cookies(), never printed, never
# written to a file — the SID/TS values live only in this process's
# memory, unlike hermes-gem-cli's ~/.gemini-cli/auth.json cache).
# Proven 2026-10-25 on the test video: init ok (Flash/Pro 597/600 credits),
# brief distillation 1638 chars, genuine Rick Astley content + timestamps.
# Limits: --gem and --followup stay on the browser path (WebAPI here is
# one-shot; Gem/conversation resume is a browser-UI concept). Model
# selection is also unavailable on WebAPI for this account (only
# 'gemini-自動' is listed), so WebAPI uses the default auto model
# regardless of -m pro/flash; the browser path still honours -m.
# 2026-10-25 fix: a URL-only WebAPI prompt cannot watch arbitrary videos
# (Gemini web replies VIDEO_NOT_ACCESSIBLE), so cmd_distill_webapi retries
# once with the video's captions (see _fetch_captions below) and the
# pointer reports source "url" or "captions:<lang>".
def _ensure_gemini_webapi():
    """Import gemini_webapi, bootstrapping it into a user cache dir if
    the system Python is PEP 668-managed (Debian/Ubuntu) and a plain
    pip install would refuse. Returns the module."""
    try:
        import gemini_webapi
        return gemini_webapi
    except ImportError:
        pass
    dep_dir = _HERMES_HOME / ".hermes" / "yt_gem_deps"
    dep_dir.mkdir(parents=True, exist_ok=True)
    if str(dep_dir) not in sys.path:
        sys.path.insert(0, str(dep_dir))
    try:
        import gemini_webapi
        return gemini_webapi
    except ImportError:
        pass
    _log("gemini-webapi not installed; bootstrapping into ~/.hermes/yt_gem_deps")
    env = dict(os.environ)
    env["TMPDIR"] = str(_HERMES_HOME / "tmp")
    Path(env["TMPDIR"]).mkdir(parents=True, exist_ok=True)
    subprocess.run([sys.executable, "-m", "pip", "install", "--quiet",
                    "--target", str(dep_dir), "gemini-webapi"],
                   env=env, timeout=300, check=False)
    import gemini_webapi
    return gemini_webapi


async def _webapi_session_cookies(args):
    """Return (sid, ts) from the signed-in profile, or (None, None).
    Launches the profile briefly (CDP if alive, else headed+forwarder),
    loads /app, checks the strict signed-in test, reads cookies, closes.
    Caller must hold the profile lock (cmd_distill acquires it)."""
    pw = ctx = page = None
    try:
        pw, ctx, page = await _launch(cdp=args.cdp)
        await page.goto(APP_URL, timeout=30000, wait_until="domcontentloaded")
        await asyncio.sleep(3)
        await _dismiss_dialogs(page)
        if not await _is_signed_in(page):
            return None, None
        cks = await ctx.cookies("https://gemini.google.com")
        d = {c["name"]: c["value"] for c in cks}
        return d.get("__Secure-1PSID"), d.get("__Secure-1PSIDTS")
    except Exception as e:
        _log(f"webapi cookie read failed: {e}")
        return None, None
    finally:
        if pw is not None:
            try:
                await _close_session(pw, ctx, page)
            except Exception:
                pass


async def _webapi_generate(args, prompt):
    """One WebAPI generation. Returns (text, elapsed) or raises.
    Raises RuntimeError with a short message on auth/dependency failure;
    the caller decides whether to fall back to the browser."""
    sid, ts = await _webapi_session_cookies(args)
    if not sid:
        raise RuntimeError("NOT_SIGNED_IN: profile has no Gemini session cookies")
    gw = _ensure_gemini_webapi()
    # No explicit model: this account's list_models() (2026-10-25) returns
    # only one model, 'gemini-自動' (Gemini 3 auto), and the old
    # Model.ADVANCED_PRO enum is deprecated and falls back to default
    # anyway with a warning. Passing a hardcoded 'gemini-2.5-pro' fails
    # resolve_model. So WebAPI always uses the account's default model;
    # the pointer's model field is corrected to 'auto' by the caller.
    t0 = time.time()
    client = gw.GeminiClient(secure_1psid=sid, secure_1psidts=ts)
    try:
        await client.init(timeout=60)
        kwargs = dict(timeout=args.timeout)
        if getattr(args, "thinking", None) == "extended":
            kwargs["extended_thinking"] = True
        resp = await client.generate_content(prompt, **kwargs)
        text = (getattr(resp, "text", "") or "").strip()
        if not text:
            raise RuntimeError("EMPTY: WebAPI returned no text")
        return text, time.time() - t0
    finally:
        try:
            await client.close()
        except Exception:
            pass


