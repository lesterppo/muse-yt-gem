_ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")
_TS_RE = re.compile(r"\b(\d{1,2}:\d{2}(?::\d{2})?)\b")
_HEADING_RE = re.compile(r"^#{2,3}\s+(.+?)\s*$", re.M)  # ## sections only, not the # title


def _log(msg):
    if QUIET:
        return
    ts = datetime.now().strftime("%H:%M:%S")
    os.write(2, f"[yt {ts}] {msg}\n".encode())


def _emit(d):
    print(json.dumps(d, ensure_ascii=False))


def _err(code, msg, **extra):
    d = {"ok": False, "err": code, "msg": msg}
    d.update(extra)
    return d


def _ok(**kw):
    d = {"ok": True}
    d.update(kw)
    return d


# ── YouTube URL parsing ───────────────────────────────────────────────────
def parse_youtube_id(s):
    """Return the 11-char video id, or None. Accepts bare ids and every
    public URL shape: watch?v=, youtu.be/, shorts/, live/, embed/, v/.
    Playlist / channel / search URLs without a video id return None."""
    if not s:
        return None
    s = s.strip()
    if _ID_RE.match(s):
        return s
    # Tolerate a bare URL pasted without scheme.
    if not re.match(r"^https?://", s, re.I):
        s = "https://" + s
    try:
        u = urlparse(s)
    except Exception:
        return None
    host = (u.hostname or "").lower()
    if host in ("youtu.be", "www.youtu.be"):
        parts = [p for p in u.path.split("/") if p]
        if parts and _ID_RE.match(parts[0]):
            return parts[0]
        return None
    if host.endswith("youtube.com") or host.endswith("youtube-nocookie.com"):
        qs = parse_qs(u.query)
        v = qs.get("v", [None])[0]
        if v and _ID_RE.match(v):
            return v
        parts = [p for p in u.path.split("/") if p]
        if len(parts) >= 2 and parts[0] in ("shorts", "live", "embed", "v"):
            if _ID_RE.match(parts[1]):
                return parts[1]
        return None
    return None


def canonical_url(video_id):
    return f"https://www.youtube.com/watch?v={video_id}"


