def build_prompt(video_id, mode="detail", question=None):
    """Build the exact prompt sent to Gemini. Pure function — unit-tested,
    and the thing --dry-run/--print-prompt shows."""
    url = canonical_url(video_id)
    if question:
        return ASK_TEMPLATE.format(url=url, video_id=video_id, question=question)
    tmpl = MODE_PROMPTS.get(mode, DETAIL_PROMPT)
    return tmpl.format(url=url, video_id=video_id)


# ── Output parsing / sidecar ──────────────────────────────────────────────
def parse_sections(md):
    """Split markdown into [{section, start, chars}] by ## / ### headings.
    The calling agent uses `start` to slice one section out of the file
    without reading the whole distillation."""
    sections = []
    matches = list(_HEADING_RE.finditer(md or ""))
    for i, m in enumerate(matches):
        end = matches[i + 1].start() if i + 1 < len(matches) else len(md)
        sections.append({
            "section": m.group(1).strip(),
            "start": m.start(),
            "chars": end - m.start(),
        })
    return sections


def parse_title(md):
    m = re.search(r"^#\s+(.+?)\s*$", md or "", re.M)
    return m.group(1).strip() if m else ""


def build_sidecar(video_id, url, mode, model, md, elapsed):
    sections = parse_sections(md)
    return {
        "video_id": video_id,
        "url": url,
        "mode": mode,
        "model": model,
        "title": parse_title(md),
        "words": len(md.split()),
        "chars": len(md),
        "timestamps": len(set(_TS_RE.findall(md))),
        "sections": [s["section"] for s in sections],
        "section_index": sections,
        "seconds": round(elapsed, 1),
        "created": datetime.now().isoformat(timespec="seconds"),
    }


def cache_paths(video_id, mode):
    # NOTE: do NOT use Path.with_suffix here — it would replace ".detail"
    # with ".md" and collapse every mode onto one <id>.md file.
    return (OUTPUT_DIR / f"{video_id}.{mode}.md",
            OUTPUT_DIR / f"{video_id}.{mode}.json")


def save_output(md, out_path, sidecar):
    out = Path(out_path)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(md, encoding="utf-8")
    side = out.with_suffix(".json")
    side.write_text(json.dumps(sidecar, ensure_ascii=False, indent=2),
                    encoding="utf-8")
    return out, side


def load_cached(video_id, mode):
    md_path, json_path = cache_paths(video_id, mode)
    if md_path.exists() and json_path.exists():
        try:
            sidecar = json.loads(json_path.read_text(encoding="utf-8"))
            return md_path, sidecar
        except Exception:
            return md_path, None
    if md_path.exists():
        return md_path, None
    return None, None


# ── Lock (shared with gem-pw) ─────────────────────────────────────────────
def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def _acquire_lock():
    global _LOCK_FD
    if _LOCK_FD is not None:
        return True
    try:
        if _LOCK_PATH.exists():
            try:
                old = _LOCK_PATH.read_text().strip()
                if old and not _pid_alive(old):
                    _LOCK_PATH.unlink()
                    _log(f"reclaimed stale lock from dead pid {old}")
            except Exception:
                pass
        _LOCK_FD = open(_LOCK_PATH, "w")
        fcntl.flock(_LOCK_FD, fcntl.LOCK_EX | fcntl.LOCK_NB)
        _LOCK_FD.write(str(os.getpid()))
        _LOCK_FD.flush()
        import atexit
        atexit.register(_release_lock)
        return True
    except OSError:
        _release_lock()
        return False
    except Exception:
        _release_lock()
        return False


def _release_lock():
    global _LOCK_FD
    if _LOCK_FD is None:
        return
    try:
        fcntl.flock(_LOCK_FD, fcntl.LOCK_UN)
    except Exception:
        pass
    try:
        _LOCK_FD.close()
    except Exception:
        pass
    _LOCK_FD = None
    try:
        _LOCK_PATH.unlink(missing_ok=True)
    except Exception:
        pass


# ── Browser (CDP-first, headed fallback — gem-pw pattern) ─────────────────
def _pick_profile():
    """gem-pw's own launch uses cr-profile; its login helper writes
    pw-profile. Prefer an existing signed-in profile over an empty one."""
    if os.environ.get("YT_GEM_PROFILE"):
        return os.environ["YT_GEM_PROFILE"]
    for cand in (_GEMINI_HOME / "cr-profile", _GEMINI_HOME / "pw-profile"):
        if cand.exists():
            return str(cand)
    return str(_GEMINI_HOME / "cr-profile")


def _cdp_alive(url=CDP_URL):
    try:
        req = urllib.request.Request(url + "/json/version")
        with urllib.request.urlopen(req, timeout=3) as r:
            return r.status == 200
    except Exception:
        return False


# ── Local CONNECT forwarder (VM egress fix) ─────────────────────────────
# Chromium + this VM's egress proxy, measured 2026-10-25:
#   direct proxy config  -> ERR_TUNNEL_CONNECTION_FAILED (auth stage)
#   forwarder (127.0.0.1:8888) -> gemini.google.com/app loads, title "Google Gemini"
# The forwarder is localhost-only, holds no credentials in code (it reads
# $https_proxy at start-up, like the tos-cli original), and is left running
# for reuse by later yt-gem/gem-pw runs. Port override: YT_GEM_FWD_PORT.
def _fwd_port():
    try:
        return int(os.environ.get("YT_GEM_FWD_PORT", "8888"))
    except ValueError:
        return 8888


def _fwd_script_path():
    here = Path(__file__).resolve().parent
    argv_dir = None
    try:
        argv_dir = Path(sys.argv[0]).resolve().parent
    except Exception:
        pass
    for cand in [
        here / "proxy_fwd.py",
        argv_dir / "proxy_fwd.py" if argv_dir else None,
        Path.home() / "workspace" / "muse-yt-gem" / "proxy_fwd.py",
        Path.home() / "workspace" / "hermes-yt-gem" / "proxy_fwd.py",
        Path.home() / "workspace" / "tos-cli" / "proxy_fwd.py",
    ]:
        if cand and cand.exists():
            return cand
    return None


def _fwd_alive(port=None):
    port = port or _fwd_port()
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=2):
            return True
    except OSError:
        return False


def _needs_forwarder():
    """True on the VM whose egress proxy Chromium cannot use directly.
    Explicit opt-out: YT_GEM_NO_FWD=1. Explicit opt-in on any network:
    YT_GEM_USE_FWD=1."""
    if os.environ.get("YT_GEM_NO_FWD") == "1":
        return False
    if os.environ.get("YT_GEM_USE_FWD") == "1":
        return True
    proxy = os.environ.get("https_proxy") or os.environ.get("HTTPS_PROXY") or ""
    return "hatch-egress-proxy" in proxy


def _ensure_forwarder():
    """Start the localhost forwarder if it is not already listening.
    Returns the proxy server URL, or None if it could not be started
    (caller then falls back to a plain headed launch)."""
    port = _fwd_port()
    if _fwd_alive(port):
        return f"http://127.0.0.1:{port}"
    script = _fwd_script_path()
    if not script:
        _log("forwarder script not found; continuing without it")
        return None
    if not (os.environ.get("https_proxy") or os.environ.get("HTTPS_PROXY")):
        _log("no https_proxy set; forwarder not needed")
        return None
    log_path = _HERMES_HOME / ".hermes" / "yt_gem_fwd.log"
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        lf = open(log_path, "ab")
        subprocess.Popen([sys.executable, str(script)], stdout=lf,
                         stderr=lf, start_new_session=True)
        for _ in range(10):
            if _fwd_alive(port):
                _log(f"forwarder started on 127.0.0.1:{port} (pid log: {log_path})")
                return f"http://127.0.0.1:{port}"
            time.sleep(0.5)
        _log("forwarder did not come up in 5s; continuing without it")
        return None
    except Exception as e:
        _log(f"forwarder start failed ({e}); continuing without it")
        return None


async def _launch_headed(proxy_server=None):
    """Headed persistent-context launch. With a forwarder proxy, also
    ignore HTTPS errors: the egress proxy's intercept CA is not trusted
    by Playwright Chromium for every host (Schwab/tos lesson, same VM)."""
    global _SESSION_MODE
    from playwright.async_api import async_playwright, Error as PwError
    profile = _pick_profile()
    for lock in ("SingletonLock", "SingletonCookie", "SingletonSocket"):
        lp = Path(profile) / lock
        if lp.exists():
            try:
                lp.unlink()
            except Exception:
                pass
    pw = await async_playwright().start()
    kwargs = dict(
        user_data_dir=profile, headless=False,
        args=["--no-sandbox", "--disable-gpu",
              "--disable-blink-features=AutomationControlled",
              "--remote-debugging-port=0"],
        ignore_default_args=["--enable-automation"])
    if proxy_server:
        kwargs["proxy"] = {"server": proxy_server}
        kwargs["ignore_https_errors"] = True
        kwargs["args"] = kwargs["args"] + ["--ignore-certificate-errors"]
    for attempt in range(3):
        try:
            ctx = await pw.chromium.launch_persistent_context(**kwargs)
            page = await ctx.new_page()
            page.set_default_timeout(180000)
            _SESSION_MODE = "headed"
            _log(f"headed launch, profile {profile}"
                 + (f", proxy {proxy_server}" if proxy_server else ""))
            return pw, ctx, page
        except PwError as e:
            if attempt < 2:
                _log(f"launch retry {attempt + 1}: {e}")
                await asyncio.sleep(2)
            else:
                raise
    raise RuntimeError("Failed to launch Chromium")


async def _launch(cdp=None, force_forwarder=False):
    """Returns (pw, ctx, page). In CDP mode the caller must NOT close the
    browser — _close_session() closes only the page."""
    global _SESSION_MODE
    # On the egress-proxy VM, a warm CDP browser started without the
    # forwarder will hit the same tunnel wall, so prefer the proven
    # headed+forwarder path there unless the caller explicitly asked
    # for a CDP endpoint (which may itself have been started via the
    # forwarder).
    want_fwd = force_forwarder or (_needs_forwarder() and not cdp)
    if want_fwd:
        fwd = _ensure_forwarder()
        if fwd:
            return await _launch_headed(proxy_server=fwd)
        _log("forwarder unavailable; falling through to CDP/headed")
    use_cdp = bool(cdp) or _cdp_alive()
    if use_cdp:
        try:
            from playwright.async_api import async_playwright
            pw = await async_playwright().start()
            browser = await pw.chromium.connect_over_cdp(cdp or CDP_URL)
            ctx = browser.contexts[0] if browser.contexts else await browser.new_context()
            page = await ctx.new_page()
            page.set_default_timeout(180000)
            _SESSION_MODE = "cdp"
            _log(f"connected via CDP ({cdp or CDP_URL})")
            try:
                await page.goto("about:blank", wait_until="domcontentloaded", timeout=15000)
                await page.keyboard.press("Escape")
                await asyncio.sleep(0.3)
            except Exception:
                pass
            return pw, ctx, page
        except Exception as e:
            _log(f"CDP connect failed ({e}); falling back to headed launch")
    return await _launch_headed()


async def _close_session(pw, ctx, page):
    try:
        if page:
            await page.close()
    except Exception:
        pass
    if _SESSION_MODE == "cdp":
        try:
            await pw.stop()
        except Exception:
            pass
        return
    try:
        await ctx.close()
    except Exception:
        pass
    try:
        await pw.stop()
    except Exception:
        pass


async def _pick(page, matchers):
