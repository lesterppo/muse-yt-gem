# ── WebAPI fix (2026-10-25): caption-fed retry ──────────────────────────
# Root cause, measured 2026-10-25 on 3 videos: the WebAPI prompt only sends
# Gemini a YouTube URL, and the Gemini web backend cannot actually fetch or
# watch an arbitrary YouTube video — it replies VIDEO_NOT_ACCESSIBLE for
# every non-famous video (Shorts 3u_x1S0FJjw, ad89q4ZlCxY, m19LBe9J1bQ all
# refused on WebAPI). The one early "success" (Rick Astley) came from the
# model's prior knowledge of a famous video, not from watching it.
# So a URL-only WebAPI backend is broken by design for ordinary videos.
# Fix: on VIDEO_NOT_ACCESSIBLE, fetch the video's own captions with yt-dlp
# and re-ask Gemini to distill FROM THE TRANSCRIPT. The result is then
# honest about its source (pointer field "source": "captions:<lang>"):
# it is a transcript distillation, not a video watch, and its timestamps
# are caption cue times. If no captions exist (e.g. the Shorts video),
# the original VIDEO_NOT_ACCESSIBLE stands — yt-gem never hallucinates a
# summary from a title alone. Whisper transcription is deliberately NOT
# bolted on here: it would pull a ~450 MB dependency + model download
# into every install for a fallback most videos never need.
def _vtt_to_text(vtt):
    """Parse a WebVTT caption file into '[MM:SS] text' lines, deduplicating
    consecutive repeated cues (YouTube VTT repeats each line across cues).
    Pure function, unit-tested."""
    lines, prev = [], None
    cur_ts = None
    for raw in (vtt or "").splitlines():
        line = raw.strip()
        if not line or line.startswith(("WEBVTT", "Kind:", "Language:")):
            continue
        if "-->" in line:
            start = line.split("-->")[0].strip()
            parts = start.split(":")
            try:
                if len(parts) == 3:
                    h, m, s = int(parts[0]), int(parts[1]), float(parts[2])
                    cur_ts = f"{h:02d}:{m:02d}:{int(s):02d}" if h else f"{m:02d}:{int(s):02d}"
                else:
                    cur_ts = start[:5]
            except ValueError:
                cur_ts = None
            continue
        if line.isdigit():
            continue
        text = re.sub(r"<[^>]+>", "", line)
        text = text.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").strip()
        if not text or text == prev:
            continue
        prev = text
        lines.append(f"[{cur_ts or '??:??'}] {text}" if cur_ts else text)
    return "\n".join(lines)


