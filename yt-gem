# ── Headless fallback: virtual display via xvfb-run ───────────────────────
# Same trick as gem-pw: headed Chromium slips past Google's anti-automation,
# but a headed browser needs an X server. Re-exec under xvfb-run when DISPLAY
# is unset so cron/SSH/remote runs still get a (virtual) headed browser.
if (not os.environ.get("DISPLAY")
        and os.environ.get("YT_GEM_XVFB", "1") != "0"
        and not os.environ.get("_YT_GEM_XVFB_WRAPPED")
        and _shutil.which("xvfb-run")):
    os.environ["_YT_GEM_XVFB_WRAPPED"] = "1"
    _xvfb = [_shutil.which("xvfb-run"), "-a", sys.executable] + sys.argv
    try:
        os.execvp(_xvfb[0], _xvfb)
    except Exception as _e:
        sys.stderr.write(f"[yt-gem] xvfb-run re-exec failed ({_e}); continuing\n")

